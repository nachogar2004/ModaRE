# ReMode Studio · variables de entorno
# Copia este fichero a .env (NO lo subas a git) o define las variables en tu servidor / proveedor de hosting.
# La app no lee .env sola: en el servidor se definen como variables de entorno (Render, Azure, systemd, docker…).

# --- Obligatorias en producción -------------------------------------------------------------
MODARE_ENV=produccion
# Base de datos (la misma para la app y para el optimizador). PostgreSQL recomendado:
#   postgresql://usuario:clave@host:5432/base      (también vale postgres://…; se convierte solo)
# En desarrollo, si no se define, se usa SQLite en code/gestion.db
MODARE_DB=postgresql://usuario:clave@localhost:5432/remode
# Clave de las sesiones (≥ 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MODARE_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Solo para la primera carga (base vacía) ------------------------------------------------
# Contraseña del usuario admin y contraseña inicial del resto de usuarios (tiendas, plantas, almacenes).
# En producción son obligatorias: no se crean usuarios con contraseñas de ejemplo.
MODARE_PASSWORD_ADMIN=
MODARE_PASSWORD_INICIAL=

# --- Opcionales -----------------------------------------------------------------------------
# 1 (defecto) = aplica las migraciones al arrancar. Con varios procesos/servidores pon 0 y ejecuta
#   flask --app app db upgrade   en cada despliegue, antes de arrancar la app.
MODARE_AUTO_MIGRAR=1
# 1 (defecto) = la app está detrás de un proxy HTTPS (nginx, Render, Azure…) y confía en sus cabeceras X-Forwarded-*
MODARE_PROXY=1
# Procesos en paralelo del optimizador (defecto: todos los procesadores). En un servidor de 2 GB, pon 2
MODARE_PROCESOS=2
# Puerto para «python app.py» (solo desarrollo)
PORT=5000
